# =============================================================
#  momiji-stack 環境変数テンプレート
# =============================================================
#  使い方:
#    1. このファイルを .env としてコピーする
#    2. 値を入力する(パスワードは利用者自身が設定する)
#    3. .env は .gitignore 済み — 絶対にコミットしない
#
#  ⚠️ 実際の値をこのテンプレートに書き込まないこと。
#     認証情報をリポジトリ・ドキュメントに平文で置かない
#     (PROJECT_CHARTER.md §4 セキュリティ方針)
# =============================================================

# --- 共通 ---
MOMIJI_TZ=Asia/Tokyo

# --- PostgreSQL (STEP3で使用) ---
MOMIJI_DB_NAME=momiji
MOMIJI_DB_USER=momiji_app
MOMIJI_DB_PASSWORD=

# --- MCP search_products (STEP5-1) ---
#  検索結果の返却件数。未設定なら 50 / 500 が使われる。
MOMIJI_DEFAULT_LIMIT=50
MOMIJI_MAX_LIMIT=500

# --- MCP API認証 (STEP5-2) ---
#  Authorization: Bearer <TOKEN> として送る。/mcp 配下のすべてのツール呼び出しに必要。
#  /health のみ認証不要(監視用)。
#  ⚠️ 未設定だとコンテナが起動しない(認証なしで公開される事故を防ぐため)。
#  ⚠️ 値はここに書かない。.env にのみ記入すること。
#  生成例: openssl rand -hex 32
MOMIJI_API_KEY=
